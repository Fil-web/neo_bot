TELEGRAM_BOT_TOKEN=your_telegram_bot_token
GIGACHAT_CREDENTIALS=your_gigachat_credentials
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_VERIFY_SSL_CERTS=true
FILKA_MAX_HISTORY=30
FILKA_DB_PATH=data/filka.db
FILKA_LOG_PATH=logs/filka.log
FILKA_ALLOWED_USER_IDS=
FILKA_ALLOW_EMPTY_WHITELIST=true
FILKA_REQUIRED_CHAT_ID=@your_channel_username
FILKA_REQUIRED_CHAT_URL=https://t.me/your_channel_username
FILKA_MAX_DOCUMENT_CHARS=12000
FILKA_CACHE_TTL_SECONDS=3600
FILKA_SPAM_WINDOW_SECONDS=20
FILKA_SPAM_MAX_REQUESTS=6
